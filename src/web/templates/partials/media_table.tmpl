{{/*
TEACHING NOTES (Go HTML Templates + HTMX-friendly rendering):
- This file is a Go `html/template` template fragment.
- `{{ ... }}` executes template actions (print values, run conditionals, loops, and include named templates).
- `.` is the current data context (similar to "this" in other languages).
- `{{ if ... }}` conditionally renders markup; `{{ range ... }}` loops over slices/maps.
- `{{ template "name" . }}` composes pages from reusable fragments.
- `html/template` auto-escapes string output, which helps prevent XSS by default.
- In this project, HTMX swaps these rendered fragments into specific targets for fast admin UX.
*/}}

{{ define "partial-media-table" }}
{{ if .FlashMessage }}
<div id="flash" hx-swap-oob="true" class="flash-warning mb-4">{{ .FlashMessage }}</div>
{{ end }}
<section id="media-table" class="space-y-4">
  <form class="panel" hx-post="/admin/media" hx-encoding="multipart/form-data" hx-target="#media-table" hx-swap="outerHTML">
    <input type="hidden" name="_csrf" value="{{ .CSRFToken }}" />
    <div class="grid gap-3 md:grid-cols-4">
      <label class="text-sm muted md:col-span-3">
        Image file (PNG/JPEG/GIF, max 10 MiB)
        <input class="input focus-ring" type="file" name="file" accept="image/png,image/jpeg,image/gif" required />
      </label>
      <div class="flex items-end">
        <button type="submit" class="btn btn-primary focus-ring">Upload</button>
      </div>
    </div>
  </form>

  <div class="table-wrap">
    <table class="data-table min-w-[760px] divide-y divide-[var(--color-border)]">
      <thead class="table-header">
        <tr>
          <th class="px-4 py-3 text-left font-medium">Name</th>
          <th class="px-4 py-3 text-left font-medium">Type</th>
          <th class="px-4 py-3 text-left font-medium">Size</th>
          <th class="px-4 py-3 text-left font-medium">Static Path</th>
          <th class="px-4 py-3 text-left font-medium">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-[var(--color-border)]">
        {{ if .Media }}
          {{ range .Media }}
          <tr class="align-top">
            <td class="px-4 py-3">
              <p class="font-medium text-[var(--color-text)]">{{ .OriginalName }}</p>
              <p class="text-xs muted">{{ .CreatedAt.Format "2006-01-02 15:04" }}</p>
            </td>
            <td class="px-4 py-3 text-[var(--color-text)]">{{ .MIME }}</td>
            <td class="px-4 py-3 text-[var(--color-text)]">{{ .Size }} bytes</td>
            <td class="px-4 py-3 font-mono text-xs text-[var(--color-text)]">/media/{{ .StoredName }}</td>
            <td class="px-4 py-3">
              <a class="btn btn-secondary btn-xs focus-ring" href="/admin/media/files/{{ .ID }}" target="_blank" rel="noreferrer">Preview</a>
            </td>
          </tr>
          {{ end }}
        {{ else }}
          <tr>
            <td colspan="5" class="px-4 py-8">
              <div class="empty-state">
                <h3 class="text-base font-semibold text-[var(--color-text)]">No uploads yet</h3>
                <p class="text-sm muted">Upload the first image to make it available for publishing.</p>
              </div>
            </td>
          </tr>
        {{ end }}
      </tbody>
    </table>
  </div>
</section>
{{ end }}
