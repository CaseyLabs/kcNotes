{{/*
TEACHING NOTES (Go HTML Templates + HTMX-friendly rendering):
- This file is a Go `html/template` template fragment.
- `{{ ... }}` executes template actions (print values, run conditionals, loops, and include named templates).
- `.` is the current data context (similar to "this" in other languages).
- `{{ if ... }}` conditionally renders markup; `{{ range ... }}` loops over slices/maps.
- `{{ template "name" . }}` composes pages from reusable fragments.
- `html/template` auto-escapes string output, which helps prevent XSS by default.
- In this project, HTMX swaps these rendered fragments into specific targets for fast admin UX.
*/}}

{{ define "partial-post-form" }}
<div id="post-form-panel" class="panel">
  {{ if .AutosaveSnapshot }}
    <div class="flash-warning mb-4" id="autosave-recovery">
      <p>A newer autosave is available for this editor.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <form method="post" action="/admin/posts/{{ .Form.ID }}/autosave/restore" hx-post="/admin/posts/{{ .Form.ID }}/autosave/restore" hx-target="#post-form-panel" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ .CSRFToken }}" />
          <button class="btn btn-primary focus-ring" type="submit">Restore Autosave</button>
        </form>
        <form method="post" action="/admin/posts/{{ .Form.ID }}/autosave/dismiss" hx-post="/admin/posts/{{ .Form.ID }}/autosave/dismiss" hx-target="#post-form-panel" hx-swap="outerHTML">
          <input type="hidden" name="_csrf" value="{{ .CSRFToken }}" />
          <button class="btn btn-secondary focus-ring" type="submit">Dismiss</button>
        </form>
      </div>
    </div>
  {{ end }}
  {{ if .FormErrors }}
    <div class="flash-error mb-4">
      {{ range .FormErrors }}<p>{{ . }}</p>{{ end }}
    </div>
  {{ end }}
  <form class="space-y-4" method="post" action="{{ .FormAction }}" {{ if .IsEdit }}hx-post="/admin/posts/{{ .Form.ID }}/autosave" hx-trigger="input changed delay:4s, change changed delay:4s" hx-target="#autosave-status" hx-swap="outerHTML" hx-indicator="#autosave-saving"{{ end }}>
    <input type="hidden" name="_csrf" value="{{ .CSRFToken }}" />
    {{ if .IsEdit }}<input type="hidden" name="base_updated_at" value="{{ .Form.BaseUpdatedAt }}" />{{ end }}

    <div class="grid gap-4 md:grid-cols-3">
      <label class="text-sm muted">
        Type
        <select class="select focus-ring" name="type" required>
          <option value="post" {{ if eq .Form.Type "post" }}selected{{ end }}>post</option>
          <option value="page" {{ if eq .Form.Type "page" }}selected{{ end }}>page</option>
        </select>
      </label>
      <label class="text-sm muted">
        Slug
        <input class="input focus-ring" type="text" name="slug" value="{{ .Form.Slug }}" placeholder="my-post-slug" />
      </label>
      <label class="text-sm muted">
        Status
        <select class="select focus-ring" name="status" required>
          <option value="draft" {{ if eq .Form.Status "draft" }}selected{{ end }}>draft</option>
          <option value="published" {{ if eq .Form.Status "published" }}selected{{ end }}>published</option>
          <option value="archived" {{ if eq .Form.Status "archived" }}selected{{ end }}>archived</option>
        </select>
      </label>
    </div>

    <label class="block text-sm muted">
      Title
      <input class="input focus-ring" type="text" name="title" value="{{ .Form.Title }}" maxlength="160" required />
    </label>

    <label class="block text-sm muted">
      Body (Markdown)
      <textarea class="textarea focus-ring" name="body_md">{{ .Form.BodyMD }}</textarea>
    </label>

    <div class="flex flex-wrap gap-2">
      <button class="btn btn-primary focus-ring" type="submit">{{ .SubmitLabel }}</button>
      <a href="/admin/posts" class="btn btn-secondary focus-ring">Cancel</a>
      {{ if .IsEdit }}
        <span id="autosave-status" class="muted self-center text-sm"></span>
        <span id="autosave-saving" class="htmx-indicator muted self-center text-sm">Saving...</span>
      {{ end }}
    </div>
  </form>
</div>
{{ end }}

{{ define "partial-autosave-status" }}
<span id="autosave-status" class="muted self-center text-sm">{{ .AutosaveStatus }}</span>
{{ end }}
