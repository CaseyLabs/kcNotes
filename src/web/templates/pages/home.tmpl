{{/*
TEACHING NOTES (Go HTML Templates + HTMX-friendly rendering):
- This file is a Go `html/template` template fragment.
- `{{ ... }}` executes template actions (print values, run conditionals, loops, and include named templates).
- `.` is the current data context (similar to "this" in other languages).
- `{{ if ... }}` conditionally renders markup; `{{ range ... }}` loops over slices/maps.
- `{{ template "name" . }}` composes pages from reusable fragments.
- `html/template` auto-escapes string output, which helps prevent XSS by default.
- In this project, HTMX swaps these rendered fragments into specific targets for fast admin UX.
*/}}

{{ define "home" }}
  {{ template "shell-start" . }}
  <main class="page-main">
    <section class="page-heading">
      <div class="hero-copy">
        <h2 class="hero-title">kcNotes Blog</h2>
        <p class="page-lede">Insights, release notes, and published updates from kcNotes.</p>
      </div>
    </section>

    <section>
      {{ if .Posts }}
        <ul class="content-list">
          {{ range .Posts }}
            <li class="content-list-item">
              <div>
                <a class="text-lg font-semibold text-slate-900 hover:underline" href="/p/{{ .Slug }}/">{{ .Title }}</a>
                <div class="content-list-meta">
                  <span>Updated {{ .UpdatedAt.Format "2006-01-02" }}</span>
                  <span>{{ .Type }}</span>
                </div>
              </div>
              <a class="btn btn-secondary btn-sm focus-ring" href="/p/{{ .Slug }}/">Read</a>
            </li>
          {{ end }}
        </ul>
      {{ else }}
        <div class="empty-state">
          <h3 class="text-base font-semibold text-slate-900">No posts yet</h3>
          <p class="max-w-md text-sm muted">Check back soon. New content is on its way.</p>
        </div>
      {{ end }}
    </section>
  </main>
  {{ template "shell-end" . }}
{{ end }}
