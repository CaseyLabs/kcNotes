{{/*
TEACHING NOTES (Go HTML Templates + HTMX-friendly rendering):
- This file is a Go `html/template` template fragment.
- `{{ ... }}` executes template actions (print values, run conditionals, loops, and include named templates).
- `.` is the current data context (similar to "this" in other languages).
- `{{ if ... }}` conditionally renders markup; `{{ range ... }}` loops over slices/maps.
- `{{ template "name" . }}` composes pages from reusable fragments.
- `html/template` auto-escapes string output, which helps prevent XSS by default.
- In this project, HTMX swaps these rendered fragments into specific targets for fast admin UX.
*/}}

{{ define "shell-start" }}
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ .Title }}</title>
    {{ if .CanonicalURL }}<link rel="canonical" href="{{ .CanonicalURL }}" />{{ end }}
    {{ if .CSRFToken }}<meta name="csrf-token" content="{{ .CSRFToken }}" />{{ end }}
    <link rel="stylesheet" href="{{ if .AssetBase }}{{ .AssetBase }}{{ else }}/static{{ end }}/css/app.css" />
    <script src="{{ if .AssetBase }}{{ .AssetBase }}{{ else }}/static{{ end }}/js/vendor/htmx-2.0.9.min.js"></script>
    <script src="{{ if .AssetBase }}{{ .AssetBase }}{{ else }}/static{{ end }}/js/app.js" defer></script>
  </head>
  <body>
    <div class="app-shell">
      <header class="app-header">
        <div class="app-header-inner">
          <div class="header-left">
            <a href="/" class="site-brand focus-ring">
              <span class="app-title">kcNotes</span>
            </a>
          </div>

          <div class="top-actions">
            <button type="button" class="theme-toggle focus-ring" data-theme-toggle aria-label="Cycle theme mode">
              <svg class="theme-toggle-icon" aria-hidden="true" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
                />
              </svg>
              <span class="sr-only" data-theme-label>System</span>
            </button>
            <a href="/admin/login" class="admin-link focus-ring">Login</a>
          </div>
        </div>
      </header>

      <div id="flash" class="mb-4"></div>
      <div id="modal"></div>
{{ end }}

{{ define "shell-end" }}
      <footer class="app-footer">
        <p>Built with Go, HTMX, and SQLite-compatible storage.</p>
      </footer>
    </div>
  </body>
</html>
{{ end }}
